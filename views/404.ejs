<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %> | <%= siteName %></title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body class="bg-gray-50 text-gray-800 flex flex-col min-h-screen">

  <%- include('partials/navbar') %>

  <main class="flex-1 flex items-center justify-center px-4 py-16">
    <div class="text-center max-w-md" role="alert">
      <p class="text-6xl font-extrabold text-blue-800 mb-4">404</p>
      <h1 class="text-2xl font-bold text-gray-800 mb-3">Halaman Tidak Ditemukan</h1>
      <p class="text-gray-600 mb-6">
        Halaman yang Anda cari tidak tersedia atau sudah dipindahkan.
      </p>
      <a href="/"
         class="inline-block bg-blue-800 text-white font-medium px-6 py-3 rounded-lg hover:bg-blue-900 transition">
        <i class="fa-solid fa-house mr-2"></i>Kembali ke Beranda
      </a>
    </div>
  </main>

  <%- include('partials/footer') %>

  <script src="/js/main.js"></script>
</body>
</html>
