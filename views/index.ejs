<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= typeof title !== 'undefined' ? title : 'Beranda' %> | <%= typeof siteName !== 'undefined' ? siteName : 'Toko Berkah Ibu Aries' %></title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body class="bg-slate-50 text-slate-800 flex flex-col min-h-screen font-sans antialiased">

  <!-- Navbar -->
  <%- include('partials/navbar') %>

  <!-- Main Container -->
  <main class="flex-1 w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 md:py-12">
    
    <!-- Hero Banner Section -->
    <section class="relative bg-gradient-to-br from-blue-900 via-blue-800 to-indigo-900 text-white rounded-3xl p-8 sm:p-12 md:p-16 mb-16 shadow-2xl overflow-hidden border border-blue-700/50">
      
      <!-- Ambient Background Elements -->
      <div class="absolute -top-24 -right-24 w-96 h-96 bg-yellow-400/10 rounded-full blur-3xl pointer-events-none"></div>
      <div class="absolute -bottom-24 -left-24 w-96 h-96 bg-blue-500/20 rounded-full blur-3xl pointer-events-none"></div>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-center relative z-10">
        
        <!-- Text Content -->
        <div class="lg:col-span-7 text-center lg:text-left">
          <span class="inline-flex items-center gap-2 bg-amber-400/20 text-amber-300 border border-amber-400/30 text-xs font-semibold uppercase tracking-wider px-3.5 py-1.5 rounded-full mb-6 backdrop-blur-md">
            <i class="fa-solid fa-sparkles text-amber-400"></i> Pilihan Utama Sembako Keluarga
          </span>
          
          <h1 class="text-3xl sm:text-5xl lg:text-6xl font-black mb-6 leading-tight tracking-tight">
            Belanja Sembako <br class="hidden sm:block" />
            <span class="text-transparent bg-clip-text bg-gradient-to-r from-amber-300 via-yellow-200 to-amber-400">Mudah & Hemat</span>
          </h1>
          
          <p class="text-blue-100 text-base sm:text-lg mb-8 max-w-2xl mx-auto lg:mx-0 leading-relaxed font-normal opacity-90">
            <%= typeof siteName !== 'undefined' ? siteName : 'Toko Berkah Ibu Aries' %> menyediakan kebutuhan pokok harian dengan jaminan harga bersahabat dan kualitas terbaik langsung untuk rumah Anda.
          </p>

          <div class="flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-4">
            <a href="/produk" class="w-full sm:w-auto inline-flex items-center justify-center bg-amber-400 text-slate-950 font-bold px-7 py-3.5 rounded-2xl shadow-lg shadow-amber-400/20 hover:bg-amber-300 transition-all duration-200 transform hover:-translate-y-0.5 text-base">
              <i class="fa-solid fa-bag-shopping mr-2.5"></i> Lihat Katalog Produk
            </a>
            <a href="/tanya-ai" class="w-full sm:w-auto inline-flex items-center justify-center bg-white/10 hover:bg-white/20 text-white font-semibold px-7 py-3.5 rounded-2xl border border-white/20 backdrop-blur-md transition-all duration-200 text-base">
              <i class="fa-solid fa-robot mr-2.5 text-amber-300"></i> Tanya Asisten AI
            </a>
          </div>

          <!-- Quick Stats / Badges -->
          <div class="mt-12 pt-8 border-t border-white/10 grid grid-cols-3 gap-4 text-center lg:text-left">
            <div>
              <p class="text-xl sm:text-2xl font-black text-white">100%</p>
              <p class="text-xs text-blue-200">Produk Original</p>
            </div>
            <div>
              <p class="text-xl sm:text-2xl font-black text-amber-300">Ramah</p>
              <p class="text-xs text-blue-200">Pelayanan Keluarga</p>
            </div>
            <div>
              <p class="text-xl sm:text-2xl font-black text-white">Setiap Hari</p>
              <p class="text-xs text-blue-200">Stok Diperbarui</p>
            </div>
          </div>
        </div>

        <!-- Hero Card Illustration -->
        <div class="lg:col-span-5 flex justify-center">
          <div class="relative w-full max-w-md">
            <div class="bg-gradient-to-tr from-white/10 to-white/5 border border-white/20 rounded-3xl p-6 backdrop-blur-xl shadow-2xl">
              
              <!-- Card Inner -->
              <div class="bg-white/10 backdrop-blur-md border border-white/20 rounded-2xl p-8 text-center shadow-inner flex flex-col items-center justify-center min-h-[280px]">
                
                <!-- Lingkaran Foto Logo -->
                <div class="w-20 h-20 bg-white/20 rounded-full flex items-center justify-center mb-4 shadow-md overflow-hidden border-2 border-amber-400/80">
                  <img 
                    src="/images/Logo.png" 
                    alt="Logo Toko Berkah" 
                    class="w-full h-full object-cover"
                    onerror="this.onerror=null; this.src='/images/logo.png';"
                  />
                </div>

                <h3 class="text-2xl font-black text-white mb-1">Toko Berkah</h3>
                <p class="text-blue-100 text-sm font-medium">Ibu Aries</p>
                <span class="mt-4 inline-flex items-center gap-1.5 px-3.5 py-1 bg-emerald-500/20 text-emerald-300 border border-emerald-400/30 text-xs font-bold rounded-full backdrop-blur-sm">
                  <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span> Buka Hari Ini
                </span>

              </div>

            </div>
          </div>
        </div>

      </div>
    </section>

    <!-- Section Produk Pilihan -->
    <section class="mb-16">
      <div class="flex flex-col sm:flex-row justify-between items-start sm:items-end gap-4 mb-8">
        <div>
          <span class="text-xs font-bold text-blue-800 tracking-widest uppercase mb-1 block">Katalog Unggulan</span>
          <h2 class="text-2xl sm:text-3xl font-black text-slate-900 tracking-tight">Produk Pilihan Hari Ini</h2>
        </div>
        <a href="/produk" class="inline-flex items-center gap-2 text-sm font-bold text-blue-800 hover:text-blue-900 transition-colors group">
          Lihat Semua Produk <i class="fa-solid fa-arrow-right text-xs transition-transform group-hover:translate-x-1"></i>
        </a>
      </div>

      <!-- Grid Produk (Memakai Partial product-card) -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        <% if (typeof previewProducts !== 'undefined' && previewProducts.length > 0) { %>
          <% previewProducts.forEach(function(product) { %>
            <%- include('partials/product-card', { product: product }) %>
          <% }); %>
        <% } else { %>
          <div class="col-span-full bg-white rounded-2xl p-12 text-center border border-slate-100">
            <i class="fa-solid fa-box-open text-4xl text-slate-300 mb-3"></i>
            <p class="text-slate-500 font-medium">Belum ada produk pilihan yang tersedia.</p>
          </div>
        <% } %>
      </div>
    </section>

    <!-- Keunggulan Section -->
    <section class="bg-white rounded-3xl p-8 sm:p-12 border border-slate-100 shadow-sm">
      <div class="text-center max-w-2xl mx-auto mb-12">
        <span class="text-xs font-bold text-blue-800 tracking-widest uppercase mb-2 block">Komitmen Kami</span>
        <h2 class="text-2xl sm:text-3xl font-black text-slate-900 tracking-tight">Kenapa Belanja di Toko Berkah?</h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <div class="p-6 rounded-2xl bg-slate-50 border border-slate-100/80 text-center hover:bg-white hover:shadow-md transition-all duration-200">
          <div class="w-14 h-14 bg-amber-100 text-amber-700 rounded-2xl flex items-center justify-center mx-auto mb-4 text-2xl shadow-inner">
            <i class="fa-solid fa-tags"></i>
          </div>
          <h3 class="font-bold text-slate-800 text-lg mb-2">Harga Bersahabat</h3>
          <p class="text-sm text-slate-500 leading-relaxed">Harga barang konsisten dan terjangkau untuk kebutuhan belanja harian keluarga Anda.</p>
        </div>

        <div class="p-6 rounded-2xl bg-slate-50 border border-slate-100/80 text-center hover:bg-white hover:shadow-md transition-all duration-200">
          <div class="w-14 h-14 bg-blue-100 text-blue-800 rounded-2xl flex items-center justify-center mx-auto mb-4 text-2xl shadow-inner">
            <i class="fa-solid fa-boxes-stacked"></i>
          </div>
          <h3 class="font-bold text-slate-800 text-lg mb-2">Stok Selalu Siap</h3>
          <p class="text-sm text-slate-500 leading-relaxed">Ketersediaan sembako dipantau dan diperbarui berkala sehingga selalu siap dibeli.</p>
        </div>

        <div class="p-6 rounded-2xl bg-slate-50 border border-slate-100/80 text-center hover:bg-white hover:shadow-md transition-all duration-200">
          <div class="w-14 h-14 bg-red-100 text-red-600 rounded-2xl flex items-center justify-center mx-auto mb-4 text-2xl shadow-inner">
            <i class="fa-solid fa-heart"></i>
          </div>
          <h3 class="font-bold text-slate-800 text-lg mb-2">Pelayanan Ramah</h3>
          <p class="text-sm text-slate-500 leading-relaxed">Dilayani dengan hangat dan ramah seperti berbelanja di toko tetangga terdekat.</p>
        </div>
      </div>
    </section>

  </main>

  <!-- Footer -->
  <%- include('partials/footer') %>

  <script src="/js/main.js"></script>
</body>
</html>