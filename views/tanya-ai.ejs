<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %> | <%= siteName %></title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body class="bg-gray-50 text-gray-800 flex flex-col min-h-screen">

  <%- include('partials/navbar') %>

  <main class="flex-1 max-w-3xl mx-auto px-4 py-10 w-full">
    <header class="mb-6 text-center">
      <h1 class="text-2xl md:text-3xl font-bold text-gray-800 mb-2">
        <i class="fa-solid fa-robot text-blue-800 mr-2"></i>Tanya AI
      </h1>
      <p class="text-gray-600 text-sm md:text-base">
        Tanyakan seputar produk sembako kami. Fitur balasan otomatis AI aktif secara *real-time*.
      </p>
    </header>

    <!-- Riwayat percakapan chat -->
    <section aria-label="Riwayat percakapan" class="bg-white rounded-xl shadow p-4 md:p-6 mb-6">
      <ul class="flex flex-col gap-4" id="chat-log">
        <li class="flex items-start gap-3">
          <div class="w-9 h-9 rounded-full bg-blue-800 text-white flex items-center justify-center flex-shrink-0">
            <i class="fa-solid fa-robot text-sm"></i>
          </div>
          <div class="bg-blue-50 text-gray-700 text-sm px-4 py-3 rounded-2xl rounded-tl-none max-w-[80%]">
            Halo! Ada yang bisa saya bantu terkait produk sembako di <%= siteName %>?
          </div>
        </li>
      </ul>
    </section>

    <!-- Form Tanya AI -->
    <section aria-labelledby="form-title" class="bg-white rounded-xl shadow p-4 md:p-6">
      <h2 id="form-title" class="sr-only">Form Pertanyaan</h2>
      <form id="chatForm" class="flex flex-col gap-4">
        <div>
          <label for="namaInput" class="block text-sm font-medium text-gray-700 mb-1">
            Nama Anda
          </label>
          <input
            type="text"
            id="namaInput"
            name="nama"
            placeholder="Masukkan nama Anda (opsional)"
            class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-700"
          />
        </div>

        <div>
          <label for="pertanyaanInput" class="block text-sm font-medium text-gray-700 mb-1">
            Pertanyaan
          </label>
          <textarea
            id="pertanyaanInput"
            name="pertanyaan"
            rows="3"
            placeholder="Contoh: Apakah beras premium tersedia dalam kemasan 10kg?"
            class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-700"
            required
          ></textarea>
        </div>

        <button
          type="submit"
          class="self-end bg-blue-800 text-white font-medium px-6 py-2.5 rounded-lg hover:bg-blue-900 transition text-sm flex items-center gap-2"
        >
          <i class="fa-solid fa-paper-plane"></i>Kirim Pertanyaan
        </button>
      </form>
    </section>
  </main>

  <%- include('partials/footer') %>

  <script src="/js/main.js"></script>
  <script>
    document.getElementById('chatForm').addEventListener('submit', async function (e) {
      e.preventDefault();

      const namaInput = document.getElementById('namaInput');
      const pertanyaanInput = document.getElementById('pertanyaanInput');
      const chatLog = document.getElementById('chat-log');

      const nama = namaInput.value.trim() || 'Anda';
      const message = pertanyaanInput.value.trim();

      if (!message) return;

      // 1. Tambahkan bubble chat user ke tampilan Tailwind
      const userLi = document.createElement('li');
      userLi.className = 'flex items-start gap-3 justify-end';
      userLi.innerHTML = `
        <div class="bg-blue-800 text-white text-sm px-4 py-3 rounded-2xl rounded-tr-none max-w-[80%]">
          <strong class="block text-xs text-blue-200 mb-1">${nama}</strong>
          ${message}
        </div>
        <div class="w-9 h-9 rounded-full bg-gray-600 text-white flex items-center justify-center flex-shrink-0">
          <i class="fa-solid fa-user text-sm"></i>
        </div>
      `;
      chatLog.appendChild(userLi);

      pertanyaanInput.value = '';

      // 2. Tambahkan indikator loading AI
      const loadingLi = document.createElement('li');
      loadingLi.id = 'loadingBubble';
      loadingLi.className = 'flex items-start gap-3';
      loadingLi.innerHTML = `
        <div class="w-9 h-9 rounded-full bg-blue-800 text-white flex items-center justify-center flex-shrink-0">
          <i class="fa-solid fa-robot text-sm"></i>
        </div>
        <div class="bg-blue-50 text-gray-500 text-sm px-4 py-3 rounded-2xl rounded-tl-none max-w-[80%] italic">
          <i class="fa-solid fa-spinner fa-spin mr-2"></i>AI sedang mengetik...
        </div>
      `;
      chatLog.appendChild(loadingLi);
      window.scrollTo({ top: document.body.scrollHeight, behavior: 'smooth' });

      try {
        // 3. Kirim data ke REST API Chat Sprint 2
        const res = await fetch('/api/chat', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ message })
        });

        const data = await res.json();
        
        const loader = document.getElementById('loadingBubble');
        if (loader) loader.remove();

        // 4. Tambahkan balasan dari AI
        const aiLi = document.createElement('li');
        aiLi.className = 'flex items-start gap-3';
        aiLi.innerHTML = `
          <div class="w-9 h-9 rounded-full bg-blue-800 text-white flex items-center justify-center flex-shrink-0">
            <i class="fa-solid fa-robot text-sm"></i>
          </div>
          <div class="bg-blue-50 text-gray-700 text-sm px-4 py-3 rounded-2xl rounded-tl-none max-w-[80%]">
            ${data.reply || data.message || 'Maaf, AI tidak dapat merespons.'}
          </div>
        `;
        chatLog.appendChild(aiLi);

      } catch (err) {
        console.error(err);
        const loader = document.getElementById('loadingBubble');
        if (loader) loader.remove();

        const errorLi = document.createElement('li');
        errorLi.className = 'flex items-start gap-3';
        errorLi.innerHTML = `
          <div class="w-9 h-9 rounded-full bg-red-600 text-white flex items-center justify-center flex-shrink-0">
            <i class="fa-solid fa-triangle-exclamation text-sm"></i>
          </div>
          <div class="bg-red-50 text-red-700 text-sm px-4 py-3 rounded-2xl rounded-tl-none max-w-[80%]">
            Gagal terhubung ke server AI. Silakan coba beberapa saat lagi.
          </div>
        `;
        chatLog.appendChild(errorLi);
      }

      window.scrollTo({ top: document.body.scrollHeight, behavior: 'smooth' });
    });
  </script>
</body>
</html>