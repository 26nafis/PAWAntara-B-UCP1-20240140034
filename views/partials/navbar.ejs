<header class="bg-blue-800 shadow-md sticky top-0 z-50 border-b-4 border-yellow-400">
  <nav class="max-w-6xl mx-auto px-4" aria-label="Navigasi utama">
    <div class="flex items-center justify-between h-16">
      <!-- Logo -->
      <a href="/" class="flex items-center gap-2 text-white font-bold text-xl">
        <i class="fa-solid fa-basket-shopping text-red-500"></i>
        <span><%= siteName %></span>
      </a>

      <!-- Menu Desktop -->
      <ul class="hidden md:flex items-center gap-1">
        <li>
          <a href="/"
             class="px-4 py-2 rounded-md text-sm font-medium transition <%= activePage === 'home' ? 'bg-blue-900 text-white' : 'text-blue-100 hover:bg-blue-700 hover:text-white' %>">
            Beranda
          </a>
        </li>
        <li>
          <a href="/produk"
             class="px-4 py-2 rounded-md text-sm font-medium transition <%= activePage === 'produk' ? 'bg-blue-900 text-white' : 'text-blue-100 hover:bg-blue-700 hover:text-white' %>">
            Produk
          </a>
        </li>
        <li>
          <a href="/tanya-ai"
             class="px-4 py-2 rounded-md text-sm font-medium transition <%= activePage === 'tanya-ai' ? 'bg-blue-900 text-white' : 'text-blue-100 hover:bg-blue-700 hover:text-white' %>">
            Tanya AI
          </a>
        </li>
      </ul>

      <!-- Tombol Hamburger (Mobile) -->
      <button
        id="hamburger-btn"
        type="button"
        class="md:hidden inline-flex items-center justify-center p-2 rounded-md text-white hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-white"
        aria-controls="mobile-menu"
        aria-expanded="false"
        aria-label="Buka menu navigasi"
      >
        <i class="fa-solid fa-bars text-xl" id="hamburger-icon"></i>
      </button>
    </div>

    <!-- Menu Mobile (di-toggle via JS) -->
    <div id="mobile-menu" class="md:hidden hidden pb-4">
      <ul class="flex flex-col gap-1">
        <li>
          <a href="/"
             class="block px-4 py-2 rounded-md text-sm font-medium <%= activePage === 'home' ? 'bg-blue-900 text-white' : 'text-blue-100 hover:bg-blue-700 hover:text-white' %>">
            Beranda
          </a>
        </li>
        <li>
          <a href="/produk"
             class="block px-4 py-2 rounded-md text-sm font-medium <%= activePage === 'produk' ? 'bg-blue-900 text-white' : 'text-blue-100 hover:bg-blue-700 hover:text-white' %>">
            Produk
          </a>
        </li>
        <li>
          <a href="/tanya-ai"
             class="block px-4 py-2 rounded-md text-sm font-medium <%= activePage === 'tanya-ai' ? 'bg-blue-900 text-white' : 'text-blue-100 hover:bg-blue-700 hover:text-white' %>">
            Tanya AI
          </a>
        </li>
      </ul>
    </div>
  </nav>
  
  <nav class="navbar navbar-expand-lg navbar-dark bg-success shadow-sm">
  <div class="container">
    <a class="navbar-brand fw-bold" href="/"><%= siteName %></a>
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
      <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse" id="navbarNav">
      <ul class="navbar-nav me-auto">
        <li class="nav-item">
          <a class="nav-link <%= activePage === 'home' ? 'active' : '' %>" href="/">Beranda</a>
        </li>
        <li class="nav-item">
          <a class="nav-link <%= activePage === 'produk' ? 'active' : '' %>" href="/produk">Katalog Produk</a>
        </li>
        <li class="nav-item">
          <a class="nav-link <%= activePage === 'tanya-ai' ? 'active' : '' %>" href="/tanya-ai">Tanya AI</a>
        </li>
      </ul>
      <ul class="navbar-nav">
        <% if (user) { %>
          <li class="nav-item">
            <a class="nav-link <%= activePage === 'dashboard' ? 'active' : '' %>" href="/dashboard">Dashboard</a>
          </li>
          <li class="nav-item">
            <button id="logoutBtn" class="btn btn-outline-light ms-2 btn-sm">Logout (<%= user.username %>)</button>
          </li>
        <% } else { %>
          <li class="nav-item">
            <a class="btn btn-light btn-sm text-success fw-bold" href="/login">Login Admin</a>
          </li>
        <% } %>
      </ul>
    </div>
  </div>
</nav>
</header>
