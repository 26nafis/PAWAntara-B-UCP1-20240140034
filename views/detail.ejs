<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %> | <%= siteName %></title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body class="bg-gray-50 text-gray-800 flex flex-col min-h-screen">

  <%- include('partials/navbar') %>

  <main class="flex-1 max-w-6xl mx-auto px-4 py-10 w-full">
    <nav aria-label="breadcrumb" class="text-sm text-gray-500 mb-6">
      <a href="/" class="hover:text-blue-800">Beranda</a>
      <span class="mx-2">/</span>
      <a href="/produk" class="hover:text-blue-800">Produk</a>
      <span class="mx-2">/</span>
      <span class="text-gray-700"><%= title %></span>
    </nav>

    <% if (product) { %>
      <article class="bg-white rounded-xl shadow overflow-hidden md:flex">
        <div class="md:w-1/2">
          <img src="<%= product.image %>" alt="<%= product.name %>" class="w-full h-72 md:h-full object-cover" />
        </div>
        <div class="p-6 md:w-1/2 flex flex-col">
          <span class="text-xs font-medium text-blue-800 uppercase tracking-wide mb-2">
            <%= product.category %>
          </span>
          <h1 class="text-2xl md:text-3xl font-bold text-gray-800 mb-3"><%= product.name %></h1>
          <p class="text-3xl font-bold text-red-600 mb-4">
            Rp<%= product.price.toLocaleString('id-ID') %>
          </p>

          <dl class="grid grid-cols-2 gap-4 mb-6 text-sm">
            <div>
              <dt class="text-gray-500">Kategori</dt>
              <dd class="font-medium text-gray-800 capitalize"><%= product.category %></dd>
            </div>
            <div>
              <dt class="text-gray-500">Stok Tersedia</dt>
              <dd class="font-medium text-gray-800"><%= product.stock %> unit</dd>
            </div>
          </dl>

          <section aria-labelledby="desc-title" class="mb-6">
            <h2 id="desc-title" class="font-semibold text-gray-800 mb-2">Deskripsi</h2>
            <p class="text-gray-600 leading-relaxed"><%= product.description %></p>
          </section>

          <div class="mt-auto flex flex-wrap gap-3">
            <a href="/produk"
               class="bg-gray-100 text-gray-700 font-medium px-6 py-3 rounded-lg hover:bg-gray-200 transition">
              <i class="fa-solid fa-arrow-left mr-2"></i>Kembali ke Produk
            </a>
          </div>
        </div>
      </article>
    <% } else { %>
      <div class="bg-white rounded-xl shadow p-10 md:p-16 text-center" role="alert">
        <i class="fa-solid fa-circle-exclamation text-5xl text-amber-500 mb-6"></i>
        <h1 class="text-2xl md:text-3xl font-bold text-gray-800 mb-3">Produk Tidak Ditemukan</h1>
        <p class="text-gray-600 mb-6">
          Maaf, produk dengan ID tersebut tidak ada dalam daftar kami. Silakan
          periksa kembali atau kembali ke halaman produk.
        </p>
        <a href="/produk"
           class="inline-block bg-blue-800 text-white font-medium px-6 py-3 rounded-lg hover:bg-blue-900 transition">
          <i class="fa-solid fa-list mr-2"></i>Lihat Semua Produk
        </a>
      </div>
    <% } %>
  </main>

  <%- include('partials/footer') %>

  <script src="/js/main.js"></script>
</body>
</html>
